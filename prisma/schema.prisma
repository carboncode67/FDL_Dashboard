  Form Form @relation(fields: [form_id], references: [id], onDelete: Cascade)

  @@unique([form_id, col_index])
  @@map("Form_Field_Definitions")
  @@schema("pgntarg2udzj1f3")
}

// Defines who can see/fill a Form — exactly one of contact/user/farm/experiment
// per row (enforced by a DB CHECK constraint in the migration). Purely an
// eligibility record: fully decoupled from FormResponse history, since Forms
// are repeatable (no "one response per recipient" constraint anywhere).
model FormAssignment {
  id                 Int      @id @default(autoincrement())
  form_id            Int
  contact_id         Int?
  user_id            String?
  farm_id            Int?
  farm_experiment_id Int?
  created_at         DateTime @default(now())

  Form           Form            @relation(fields: [form_id], references: [id], onDelete: Cascade)
  Contact        Contact?        @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  User           User?           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Farm           Farm?           @relation(fields: [farm_id], references: [id], onDelete: Cascade)
  FarmExperiment FarmExperiment? @relation(fields: [farm_experiment_id], references: [id], onDelete: Cascade)

  @@index([form_id])
  @@index([contact_id])
  @@index([user_id])
  @@index([farm_id])
  @@index([farm_experiment_id])
  @@map("Form_Assignments")
  @@schema("pgntarg2udzj1f3")
}

model FormResponse {
  id           Int      @id @default(autoincrement())
  form_id      Int
  contact_id   Int?
  user_id      String?
  farm_id      Int?     // resolved at submission time via lib/proximity.ts
  data         Json     // JSONB keyed by FormFieldDefinition.col_index as a string — no FK to field defs
  content_hash String?  // client-supplied dedup key, same pattern as Photos/Notes/Recordings
  submitted_at DateTime @default(now()) @db.Timestamptz(6)

  Form    Form     @relation(fields: [form_id], references: [id], onDelete: Cascade)
  Contact Contact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  User    User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  Farm    Farm?    @relation(fields: [farm_id], references: [id], onDelete: SetNull)

  @@index([form_id])
  @@index([contact_id])
  @@index([user_id])
  @@index([content_hash])
  @@map("Form_Responses")
  @@schema("pgntarg2udzj1f3")
}

// Phase 1 geofencing: staff draw a polygon and assign it to an individual contact/user (or
// broadly to a farm/experiment, same shape as Form_Assignments) with a simple notification
// action. Detection is entirely on-device (hybrid OS circular-region wake trigger + precise
// point-in-polygon check on wake) — this table is config only, never triggers anything itself.
// Phase 2: a Geofence is a named group of one or more GeofenceZones (each a farm-scoped
// circle covering one or more Fields on that farm), replacing Phase 1's single freehand-drawn
// polygon. notify_on_circle_entry/notify_on_field_entry are geofence-level (apply to every
// zone) and replace the old action_type — both are just "fire a notification," the type
// distinction that mattered was WHICH geometry triggers it, now modeled directly by these
// two flags instead of a string enum.
model Geofence {
  id                     Int      @id @default(autoincrement())
  title                  String
  description            String?
  is_active              Boolean  @default(true)
  notify_on_circle_entry Boolean  @default(true)  // fire on entering a zone's circle ("near fields")
  notify_on_field_entry  Boolean  @default(false) // fire on entering one of a zone's exact Field boundaries
  action_message         String?  // optional override notification body; null => client generates
                                   // per-event text ("You're near {Farm}" / "You've entered {Field}")
  created_by_id          String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  CreatedBy   User?                @relation("GeofenceCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  Zones       GeofenceZone[]
  Assignments GeofenceAssignment[]
  Events      GeofenceEvent[]

  @@map("Geofences")
  @@schema("pgntarg2udzj1f3")
}

// One farm-scoped circle within a Geofence. center/radius are seeded server-side from the
// bounding circle of the selected Fields (staff can then drag/resize in the wizard before
// saving) — mobile clients never derive this themselves, they just consume the stored values.
model GeofenceZone {
  id            Int      @id @default(autoincrement())
  geofence_id   Int
  farm_id       Int
  center_lat    Float
  center_lng    Float
  radius_meters Float
  created_at    DateTime @default(now())

  Geofence Geofence            @relation(fields: [geofence_id], references: [id], onDelete: Cascade)
  Farm     Farm                @relation(fields: [farm_id], references: [id], onDelete: Cascade)
  Fields   GeofenceZoneField[]

  @@index([geofence_id])
  @@index([farm_id])
  @@map("Geofence_Zones")
  @@schema("pgntarg2udzj1f3")
}

// Which Fields a GeofenceZone was drawn around — used for the exact-boundary check when
// notify_on_field_entry is on (the zone's circle alone isn't precise enough for that mode).
model GeofenceZoneField {
  zone_id  Int
  field_id Int

  Zone  GeofenceZone @relation(fields: [zone_id], references: [id], onDelete: Cascade)
  Field Field        @relation(fields: [field_id], references: [id], onDelete: Cascade)

  @@id([zone_id, field_id])
  @@index([field_id])
  @@map("Geofence_Zone_Fields")
  @@schema("pgntarg2udzj1f3")
}

// Defines who a Geofence's on-device monitoring + notification applies to — exactly one of
// contact/user/farm/experiment per row (DB CHECK constraint in the migration), same shape and
// same known limitation as Form_Assignments (lab members have no Farm<->User relation, so a
// broad farm/experiment assignment only resolves to Contact recipients).
model GeofenceAssignment {
  id                 Int      @id @default(autoincrement())
  geofence_id        Int
  contact_id         Int?
  user_id            String?
  farm_id            Int?
  farm_experiment_id Int?
  created_at         DateTime @default(now())

  Geofence       Geofence        @relation(fields: [geofence_id], references: [id], onDelete: Cascade)
  Contact        Contact?        @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  User           User?           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Farm           Farm?           @relation(fields: [farm_id], references: [id], onDelete: Cascade)
  FarmExperiment FarmExperiment? @relation(fields: [farm_experiment_id], references: [id], onDelete: Cascade)

  @@index([geofence_id])
  @@index([contact_id])
  @@index([user_id])
  @@index([farm_id])
  @@index([farm_experiment_id])
  @@map("Geofence_Assignments")
  @@schema("pgntarg2udzj1f3")
}

// Log of confirmed on-device entries — written client-side AFTER the precise polygon check
// passes, POSTed for staff visibility only. Purely additive/informational, same relationship to
// Geofence as Form_Responses is to Forms (decoupled from "assignment", no completion semantics).
// No server-side polygon re-validation on the POST — the device already did the authoritative
// check; a strict re-check would produce GPS-accuracy false rejections.
model GeofenceEvent {
  id           Int      @id @default(autoincrement())
  geofence_id  Int
  contact_id   Int?
  user_id      String?
  event_type   String   @default("enter") // Phase 1: always "enter"; exit reserved for later
  lat          Float
  lng          Float
  occurred_at  DateTime                    // device-reported timestamp of the precise fix
  received_at  DateTime @default(now()) @db.Timestamptz(6)
  content_hash String?                     // client dedup key, same pattern as Notes/Locations

  Geofence Geofence @relation(fields: [geofence_id], references: [id], onDelete: Cascade)
  Contact  Contact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  User     User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([geofence_id])
  @@index([contact_id])
  @@index([user_id])
  @@index([content_hash])
  @@map("Geofence_Events")
  @@schema("pgntarg2udzj1f3")
}

model Pipeline {
