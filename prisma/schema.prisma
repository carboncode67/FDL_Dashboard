model PipelineRun {
  id                      Int       @id @default(autoincrement())
  pipeline_id             Int
  is_test_run             Boolean   @default(false)
  trigger_upload_id       Int?
  trigger_upload_table    String?
  trigger_data_table_id   Int?      // for test-data-rows auto-runs: which Data Table's ingest fired this
  target_drone_flight_id  Int?      // set for target_kind = "drone_flight" runs instead of trigger_upload_*
  status                  String    @default("queued") // queued | running | success | failed
  external_job_id         String?
  prompt                  String?   // operator instruction for a re-run, re-wired by the processor LLM
  processor_note          String?   // short status the processor emits back ("CRS unclear")
  stdout_log              String?
  stderr_log              String?
  output_files            Json      @default("[]")
  output_storage_path     String?   // final zraid1 path the processing machine wrote to, for drone-flight runs
  error_message           String?
  started_at              DateTime?
  finished_at             DateTime?
  created_at              DateTime  @default(now())
  // Resolved once at creation from whichever trigger shape applies (see
  // lib/pipeline-farm.ts) — NULL means no farm could be resolved (e.g. a manual
  // "Run"/registration test-run with no upload/experiment context).
  farm_id                 Int?

  Pipeline          Pipeline                @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  TargetDroneFlight DroneFlightRecord?      @relation(fields: [target_drone_flight_id], references: [id], onDelete: SetNull)
  Farm              Farm?                   @relation(fields: [farm_id], references: [id], onDelete: SetNull)
  OutputRasters     PipelineOutputRaster[]

  @@index([pipeline_id])
  @@index([status])
  @@index([target_drone_flight_id])
  @@index([farm_id])
  @@map("Pipeline_Runs")
  @@schema("pgntarg2udzj1f3")
}

// A spatial (raster or vector) pipeline output, pulled down from the processing
// machine and linked to the farm its triggering run resolved to, so it can be shown
// on that farm's map. Same shape/precedent as ContextRaster; farm_id is only ever
// set when the run itself resolved to a farm — see PipelineRun.farm_id. Despite the
// table name (predates vector support), `kind` distinguishes raster vs. vector.
model PipelineOutputRaster {
  id                Int      @id @default(autoincrement())
  pipeline_run_id   Int
  farm_id           Int
  filename          String // flat basename under DATA_DIR/pipeline-outputs/
  original_filename String // the name the processing machine's output/ dir gave it
  bytes             BigInt
  sha256            String
  kind              String   @default("raster") // "raster" | "vector"
  // Set by PipelineProcessor's geo_sanity.py, which verifies the output's own
  // centroid against the run's farm centroid before ever reaching here and
  // reprojects to EPSG:4326 on a confident match. "ok" = safe to render as-is;
  // "unclear" = left un-normalized, do not plot (see components/farm-map.tsx);
  // NULL = no farm to check against (shouldn't occur here since farm_id is required,
  // but tolerated for pre-migration rows).
  crs_status        String?
  crs_epsg          Int?    // the EPSG geo_sanity matched, when crs_status = "ok"
  created_at        DateTime @default(now())

  Run  PipelineRun @relation(fields: [pipeline_run_id], references: [id], onDelete: Cascade)
  Farm Farm        @relation(fields: [farm_id], references: [id], onDelete: Cascade)

  @@index([pipeline_run_id])
  @@index([farm_id])
  @@map("Pipeline_Output_Rasters")
  @@schema("pgntarg2udzj1f3")
}

model ContextFetchJob {
  id                 Int       @id @default(autoincrement())
  farm_id            Int
  requested_by       String?
  products           String[]  @default([]) // GeoDaRT product codes: POLARIS | USGS3DEP_10m | USDroughtMonitor | SOLUS | Sentinel2
  start_date         DateTime  @db.Date
  end_date           DateTime  @db.Date
  buffer_m           Float     @default(150)
  aoi                Json // the [[lon,lat],...] ring sent to GeoDaRT
  export_format      String    @default("COG")
  status             String    @default("pending") // pending | submitted | running | success | partial | failed
  progress           Int       @default(0)
  geodart_job_id     String?
  geodart_request_id String?
  product_results    Json      @default("{}")
  error_message      String?
  claimed_at         DateTime? // optimistic lock for the cron sweep
  created_at         DateTime  @default(now())
  submitted_at       DateTime?
  finished_at        DateTime?

  Farm      Farm            @relation(fields: [farm_id], references: [id], onDelete: Cascade)
  Requester User?           @relation(fields: [requested_by], references: [id], onDelete: SetNull)
  Rasters   ContextRaster[]

  @@index([status])
  @@index([farm_id])
  @@map("Context_Fetch_Jobs")
  @@schema("pgntarg2udzj1f3")
}

model ContextRaster {
  id           Int       @id @default(autoincrement())
  job_id       Int
  farm_id      Int
  product      String
  band_names   String[]  @default([])
  start_date   DateTime? @db.Date
  end_date     DateTime? @db.Date
  capture_date DateTime? @db.Date
  filename     String // flat basename under DATA_DIR/context/
  bytes        BigInt
  sha256       String
  footprint    Json // GeoJSON Polygon of the requested AOI bbox
  crs          String?
  pixel_size_m Float?
  fetched_at   DateTime  @default(now())

  Job  ContextFetchJob @relation(fields: [job_id], references: [id], onDelete: Cascade)
  Farm Farm            @relation(fields: [farm_id], references: [id], onDelete: Cascade)

  @@unique([job_id, filename])
  @@index([job_id])
  @@index([farm_id, product])
  @@map("Context_Rasters")
  @@schema("pgntarg2udzj1f3")
}
