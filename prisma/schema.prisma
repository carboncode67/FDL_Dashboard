  match_table                   String?   // photos | notes | recordings | locations | lab-member-uploads | test-data-rows | documents — null for target_kind = "drone_flight"
  match_category                String?
  match_project_id              Int?
  match_data_table_id           Int?
  use_spatial_context           Boolean   @default(false) // tell the processing LLM per-farm spatial-context rasters are available for interpolation
  sample_dataset_filename       String
  sample_dataset_original_name  String
  script_filename                String
  script_original_name           String
  model_filename                 String?
  model_original_name            String?
