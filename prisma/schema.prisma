  contact_id    Int?
  farm_id       Int?
  project_id    Int?
  test_id       Int?
  // Data Table this document's columns were auto-matched against at upload
  // time (see lib/document-template-match.ts) — a document, not a row, so
  // this only records the match for pipeline scoping / provenance; the
  // actual parsed data still goes through the ordinary
  // experiment-tests/[id]/tables/[tableId]/rows ingest path, not here.
  // drone_id mirrors test_id for an Equipment(Drone)-homed match, since a
  // DataTable can be homed to either. Independent of test_id: a Test-scoped
  // upload (app/api/tests/[id]/documents) sets test_id explicitly regardless
