model Form {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  is_active     Boolean   @default(true)
  created_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  CreatedBy        User?                 @relation("FormCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  FieldDefinitions FormFieldDefinition[]
  Assignments      FormAssignment[]
  Responses        FormResponse[]

  @@map("Forms")
  @@schema("pgntarg2udzj1f3")
}

// col_index-keyed field definitions for a custom Form, mirroring the
// Test_Field_Definitions / Test_Data_Rows pattern: FormResponse.data is
// JSONB keyed by col_index as a string, with no FK to this table, since
// schema edits delete+recreate field definitions.
model FormFieldDefinition {
  id         Int     @id @default(autoincrement())
  form_id    Int
  col_index  Int
  field_type String  @default("text") // text | number | boolean | date | select
  label      String
  required   Boolean @default(false)
  options    Json?                     // string[] — only used when field_type = "select"

  Form Form @relation(fields: [form_id], references: [id], onDelete: Cascade)

  @@unique([form_id, col_index])
  @@map("Form_Field_Definitions")
  @@schema("pgntarg2udzj1f3")
}

// Defines who can see/fill a Form — exactly one of contact/user/farm/experiment
// per row (enforced by a DB CHECK constraint in the migration). Purely an
// eligibility record: fully decoupled from FormResponse history, since Forms
// are repeatable (no "one response per recipient" constraint anywhere).
model FormAssignment {
  id                 Int      @id @default(autoincrement())
  form_id            Int
  contact_id         Int?
  user_id            String?
  farm_id            Int?
  farm_experiment_id Int?
  created_at         DateTime @default(now())

  Form           Form            @relation(fields: [form_id], references: [id], onDelete: Cascade)
  Contact        Contact?        @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  User           User?           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Farm           Farm?           @relation(fields: [farm_id], references: [id], onDelete: Cascade)
  FarmExperiment FarmExperiment? @relation(fields: [farm_experiment_id], references: [id], onDelete: Cascade)

  @@index([form_id])
  @@index([contact_id])
  @@index([user_id])
  @@index([farm_id])
  @@index([farm_experiment_id])
  @@map("Form_Assignments")
  @@schema("pgntarg2udzj1f3")
}

model FormResponse {
  id           Int      @id @default(autoincrement())
  form_id      Int
  contact_id   Int?
  user_id      String?
  farm_id      Int?     // resolved at submission time via lib/proximity.ts
  data         Json     // JSONB keyed by FormFieldDefinition.col_index as a string — no FK to field defs
  content_hash String?  // client-supplied dedup key, same pattern as Photos/Notes/Recordings
  submitted_at DateTime @default(now()) @db.Timestamptz(6)

  Form    Form     @relation(fields: [form_id], references: [id], onDelete: Cascade)
  Contact Contact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  User    User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  Farm    Farm?    @relation(fields: [farm_id], references: [id], onDelete: SetNull)

  @@index([form_id])
  @@index([contact_id])
  @@index([user_id])
  @@index([content_hash])
  @@map("Form_Responses")
  @@schema("pgntarg2udzj1f3")
}

model Pipeline {
  id                            Int       @id @default(autoincrement())
  name                          String
  description                   String?
  status                        String    @default("draft") // draft | testing | live | failed | disabled
  target_kind                   String?   // null = upload-matched (default) | "drone_flight" = manual per-flight, see PipelineRun.target_drone_flight_id
  match_table                   String?   // photos | notes | recordings | locations | lab-member-uploads | test-data-rows | documents — null for target_kind = "drone_flight"
  match_category                String?
  match_project_id              Int?
  match_test_id                 Int?
  sample_dataset_filename       String
  sample_dataset_original_name  String
  script_filename                String
  script_original_name           String
  model_filename                 String?
  model_original_name            String?
  wired_command                 String?
  wired_requirements             String?
  llm_notes                      String?
  external_pipeline_id          String?
  last_run_at                   DateTime?
  last_run_status                String?
  created_by                     String?
  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt

  Creator User?         @relation(fields: [created_by], references: [id], onDelete: SetNull)
  Runs    PipelineRun[]

  @@index([status])
  @@index([match_table])
  @@map("Pipelines")
  @@schema("pgntarg2udzj1f3")
}

model PipelineRun {
  id                      Int       @id @default(autoincrement())
  pipeline_id             Int
  is_test_run             Boolean   @default(false)
  trigger_upload_id       Int?
  trigger_upload_table    String?
  target_drone_flight_id  Int?      // set for target_kind = "drone_flight" runs instead of trigger_upload_*
  status                  String    @default("queued") // queued | running | success | failed
  external_job_id         String?
  stdout_log              String?
  stderr_log              String?
  output_files            Json      @default("[]")
  output_storage_path     String?   // final zraid1 path the processing machine wrote to, for drone-flight runs
  error_message           String?
  started_at              DateTime?
  finished_at             DateTime?
  created_at              DateTime  @default(now())

  Pipeline          Pipeline           @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  TargetDroneFlight DroneFlightRecord? @relation(fields: [target_drone_flight_id], references: [id], onDelete: SetNull)

  @@index([pipeline_id])
  @@index([status])
  @@index([target_drone_flight_id])
  @@map("Pipeline_Runs")
  @@schema("pgntarg2udzj1f3")
}
