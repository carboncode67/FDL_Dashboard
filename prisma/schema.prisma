}

// col_index-keyed field definitions for a custom Form, mirroring the
// Test_Field_Definitions / Test_Data_Rows pattern: FormResponse.data is
// JSONB keyed by col_index as a string, with no FK to this table, since
// schema edits delete+recreate field definitions.
model FormFieldDefinition {
  id         Int     @id @default(autoincrement())
  form_id    Int
  col_index  Int
  field_type String  @default("text") // text | number | boolean | date | select
  label      String
  required   Boolean @default(false)
