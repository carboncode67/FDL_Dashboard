# Copy to .env and fill in values before running docker compose
#   cp .env.example .env
# docker compose reads .env automatically for variable substitution in
# docker-compose.yml (itself copied from sample_compose.yaml) — no extra
# flags needed.

# Postgres password — pick a real one, this is baked into the db container
# on first init and used by the app's DATABASE_URL. Changing it later means
# also running ALTER USER nocodb WITH PASSWORD '...'; in the running db
# (or wiping the db-data volume to reinit).
POSTGRES_PASSWORD=change-me

# URL this server is reachable at — used for NextAuth callbacks and QR code payloads
NEXTAUTH_URL=http://YOUR_SERVER_IP:3000

# Random secret for NextAuth JWT signing — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# Only needed if the mobile app reaches the server on a different port than 3000
# FARMER_SERVER_URL=http://YOUR_SERVER_IP:3300

# Base URL of the OFEDashBot webhook service (holds the Twilio credentials).
# Required for the WhatsApp admin "send message" feature (POST /api/whatsapp/send).
# OFEDASHBOT_URL=http://YOUR_BOT_HOST:PORT

# SMTP credentials for outgoing email — scheduled activity reports and the
# "Send Onboarding Email" button (Contacts / Lab Members). Works with any
# mailbox that exposes SMTP (Gmail, Office365, institutional mail, etc).
# For Gmail/Office365 you'll likely need an app password, not the account's
# normal login password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465 (implicit TLS); false for 587/25 (STARTTLS)
# SMTP_USER=lab@yourdomain.com
# SMTP_PASSWORD=your-smtp-password-or-app-password
# SMTP_FROM_EMAIL=lab@yourdomain.com   # optional, defaults to SMTP_USER

# CVAT annotation integration (optional — tasks are saved locally if CVAT vars are not set)
# CVAT_URL=http://your-cvat-host:8080
# CVAT_USERNAME=admin
# CVAT_PASSWORD=your-cvat-password
# CVAT_WEBHOOK_SECRET=random-secret-for-webhook-verification
# NEXT_PUBLIC_CVAT_URL=http://your-cvat-host:8080

# GeoDaRT spatial-context pulls (the "Pull spatial context" button on farm pages).
# All optional — the feature works keyless for the 3 default products
# (POLARIS soil, USGS 3DEP terrain, US Drought Monitor). SOLUS + Sentinel-2 need a
# GeoDaRT key that hasn't been issued yet.
# GEODART_URL=https://geodart-api.farmersdatalab.scienceversa.com   # default; override to point elsewhere
# GEODART_USER_GUID=...        # once GeoDaRT issues accounts
# GEODART_USER_EMAIL=lab@yourdomain.com
# GEODART_PASSWORD_HASH=...    # unlocks SOLUS + Sentinel-2

# Automated processing pipelines ("Processing" tab, item 90) — optional, the
# feature is disabled (registration/run calls are skipped) unless PROCESSING_URL
# and PROCESSING_API_KEY are both set. Points at a PipelineProcessor instance
# running on its own dedicated machine — see FarmersDatabase/PipelineProcessor/CLAUDE.md.
# PROCESSING_URL=http://your-processing-host:8010
# PROCESSING_API_KEY=random-key-shared-with-the-processor's-PROCESSING_API_KEY
# PROCESSING_WEBHOOK_SECRET=random-secret-shared-with-the-processor's-PROCESSING_WEBHOOK_SECRET
# PIPELINE_MAX_UPLOAD_BYTES=2147483648   # optional, default 2GB cap on sample/script/model uploads

# Vikunja task sync (optional — tasks are saved locally only if Vikunja vars are not set)
# VIKUNJA_URL=http://vikunja:3456
# VIKUNJA_TOKEN=your-vikunja-api-token
# VIKUNJA_WEBHOOK_SECRET=random-secret-for-webhook-verification
# NEXT_PUBLIC_VIKUNJA_URL=http://your-vikunja-host:3456
